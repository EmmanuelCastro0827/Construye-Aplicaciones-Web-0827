<!-- Indica que se está utilizando HTML5 -->
<!DOCTYPE html>

<!-- Etiqueta principal que contiene todo el documento HTML -->
<html lang="en">

<head>
    <!-- Contiene información y configuraciones de la página que no se muestran directamente -->
    <meta charset="UTF-8">

    <!-- Hace que la página se adapte al tamaño de la pantalla -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Define el título que aparece en la pestaña del navegador -->
    <title>Imagenes en HTML</title>
</head>

<body>
    <!-- Contiene todo el contenido visible de la página -->
    
    <!-- Crea un encabezado de nivel 2 -->
    <h2>Imagenes en HTML</h2>

    <!-- Crea un encabezado de nivel 3 -->
    <h3>Locales</h3>

    <!-- img sirve para insertar una imagen -->
    <!-- src indica la ubicación de la imagen -->
    <!-- alt proporciona un texto alternativo para la imagen -->
    <img src="caritas.png" alt="Imagen de carita feliz">

    <h3>Locales redismensionado</h3>

    <!-- width establece el ancho de la imagen -->
    <!-- height establece la altura de la imagen -->
    <img src="imagenes/carita.png" alt="" width="200" height="100">

    <h3>Desde internet</h3>

    <img src="https://st2.depositphotos.com/2172759/11751/v/950/depositphotos_117511772-stock-illustration-happy-face-isolated-on-white.jpg" 
    width="200" height="200"
    alt="">

    <h3>Animaciones</h3>

    <!-- También se pueden mostrar imágenes animadas en formato GIF -->
    <img src="https://media3.giphy.com/media/v1.Y2lkPTc5MGI3NjExejMydmVybzBiY3lkdWd1Nnp1MzJiMXA3Ymt3czE3NGp1NDZuZDg5YiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/tXL4FHPSnVJ0A/giphy.gif" 
    width="200" height="200"
    alt="">
</body>

</html>
