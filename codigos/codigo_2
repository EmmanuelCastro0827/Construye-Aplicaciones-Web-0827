<!DOCTYPE html> <!-- Avisa al navegador que esta es una página web -->
<html lang="en"> <!-- Inicio de toda la página -->

<head> <!-- Información que la página necesita pero que no se ve en pantalla -->
    <meta charset="UTF-8"> <!-- Para poder usar acentos y la letra ñ sin errores -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Para que se vea bien en celulares -->
    <title>Parrafos HTML</title> <!-- Nombre que sale arriba en la pestaña -->
</head>

<body> <!-- Todo lo que SÍ se ve en la pantalla -->
    <h1>Estructura del HTML</h1> <!-- h1: El título principal (el más grande) -->

    <h2>HTML</h2> <!-- h2: Un subtítulo -->
    <p>Envuelve todo el contenido de la pagina</p> <!-- p: Sirve para escribir párrafos de texto normal -->

    <h2>Head</h2>
    <p>Contiene los metadatos del sitio web,
        configuraciones y el titulo de la pestaña
    </p>

    <h2>Body</h2>
    <p>Muestra los elementos visuales que ve el usuario</p>

    <h2>Footer</h2>
    <p>Muestra la informacion del autor de la pagina,
        creditos, informacion relevante, etc.
    </p>
</body>

</html>
