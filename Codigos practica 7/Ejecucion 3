<!DOCTYPE html> <!-- Documento HTML5 -->
<html lang="es">
<head>
<meta charset="UTF-8"> <!-- Acentos y ñ -->
<title>Formulario con text area</title> <!-- Titulo de la pestaña -->
</head>
<body> <!-- Contenido visible -->
<h2>Formulario con text area</h2>
<form action="" method="post">
Ingresa tu nombre:
<input type="text" name="nombre">
<br>
Ingresa tu correo:
<!-- email: valida que el texto sea un correo -->
<input type="email" name="correo">
<br>
Ingresa tus comentarios:
<!-- textarea: texto de varias lineas (rows = filas, cols = ancho) -->
<textarea name="comentarios" rows="1" cols="10"></textarea>
<br>
<input type="submit" value="enviar">
<input type="reset" value="borrar">
</form>
</body>
</html>
