<!DOCTYPE html> <!-- Documento HTML5 -->
<html lang="es">
<head>
<meta charset="UTF-8"> <!-- Acentos y ñ -->
<title>Formularios con selección</title> <!-- Titulo de la pestaña -->
</head>
<body> <!-- Contenido visible -->
<h2>Formularios con seleccion</h2>
<form action="" method="post">
Ingresa tu nombre:
<input type="text" name="nombre"><br>
Selecciona tu pais:
<!-- select: lista desplegable; option: cada opcion de la lista -->
<select name="pais">
<option value="1">Argentina</option>
<option value="2">España</option>
<option value="3">Mexico</option>
<option value="4">Guatemala</option>
<option value="5">Honduras</option>
<option value="6">El Salvador</option>
<option value="7">Venezuela</option>
<option value="8">Colombia</option>
</select>
<br>
<input type="submit" value="enviar">
<input type="reset" value="borrar">
</form>
</body>
</html>
