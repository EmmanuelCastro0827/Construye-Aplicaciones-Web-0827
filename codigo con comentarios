<!DOCTYPE html> <!-- Indica que el documento es HTML5 -->
<html lang="en"> <!-- Inicio de la página (idioma inglés) -->

<head> <!-- Configuración e información invisible de la página -->
    <meta charset="UTF-8"> <!-- Permite usar acentos y la letra ñ -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Adapta la página a pantallas de celulares -->
    <title>Encabezados HTML</title> <!-- Título que se ve en la pestaña del navegador -->
</head>

<body> <!-- Aquí va todo lo que sí se ve en la pantalla -->
   
    <h1>Titulo 1</h1> <!-- El título más grande e importante -->
    <h2>Titulo 2</h2> <!-- Subtítulo -->
    <h3>Titulo 3</h3> <!-- Subtítulo más pequeño -->
    <h4>Titulo 4</h4> <!-- Texto de encabezado mediano-pequeño -->
    <h5>Titulo 5</h5> <!-- Texto de encabezado pequeño -->
    <h6>Titulo 6</h6> <!-- El título más pequeño de todos -->
</body>

</html>
